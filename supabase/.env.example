# Copy to supabase/.env and fill in. That file is gitignored — secrets never
# enter the repository, only this template does.
#
# The secret block is generated, not invented:
#
#     cp supabase/.env.example supabase/.env
#     node scripts/mint-keys.mjs >> supabase/.env      # then delete the blank ones above
#
# Local dev and production MUST NOT share these values. This stack is for LOCAL
# development; production Supabase lives on Patrick and is configured there.

# ── Secrets (from scripts/mint-keys.mjs) ──────────────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
# EXACTLY 16 characters — Realtime encrypts tenant secrets with aes_128_ecb and
# passes this straight through as key material. Anything else crash-loops the
# container with `:badarg ... Bad key size` from inside Erlang's crypto.
REALTIME_DB_ENC_KEY=

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── URLs ──────────────────────────────────────────────────────────────────
# The port the gateway publishes on the host. 8002 mirrors what Kong uses on
# Patrick, so the mental model matches; it also cannot collide with the
# CoastSnap stack (8010) if you run both.
SUPABASE_PORT=8002
SUPABASE_BIND=127.0.0.1

# Where the browser reaches this stack. These feed GoTrue's issuer/redirects
# and storage's public URLs, so a wrong value breaks auth links and image URLs
# rather than failing loudly.
API_EXTERNAL_URL=http://localhost:8002
SUPABASE_PUBLIC_URL=http://localhost:8002
# The app's dev port — `npm run dev` binds 3050, not 3000.
SITE_URL=http://localhost:3050
ADDITIONAL_REDIRECT_URLS=

# ── Auth policy ───────────────────────────────────────────────────────────
# BOTH of these are required for the volunteer flow. A volunteer arriving from
# a QR code has no account: /submit calls signInAnonymously(), which mints a
# real auth.users row so ordinary owner-based RLS applies with no special
# cases. An anonymous sign-in counts as a SIGNUP, so DISABLE_SIGNUP must be
# false as well — setting only ENABLE_ANONYMOUS_USERS is the common mistake and
# it fails with "Could not start a session" on the submit page.
#
# This does NOT open the CMS: /admin is gated on profiles.is_admin, not on
# merely being signed in (see proxy.ts).
DISABLE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
JWT_EXPIRY=3600

# ── Mail ──────────────────────────────────────────────────────────────────
# Only needed for password-reset mail. Left blank, GoTrue still starts; the
# reset link simply never arrives. Fine for local work.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Meander Monitor

# ── PostgREST / Storage ───────────────────────────────────────────────────
# Leave MAX_ROWS at upstream's 1000: the app is written against it (the
# water-level page fetches one series per request precisely because a week of
# 10-minute buckets is ~1000 rows). Raising it locally would hide a truncation
# bug until deploy.
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_MAX_ROWS=1000
# 100 MB — matches next.config.ts's serverActions.bodySizeLimit and the
# gateway's client_max_body_size, so one number governs the whole upload path.
STORAGE_FILE_SIZE_LIMIT=104857600
STORAGE_TENANT_ID=meander-monitor
REGION=local
