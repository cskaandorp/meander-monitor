# Harvest WUR's Munisense water readings into our own tables.
#
# Install to /etc/systemd/system/meander-water.service alongside
# meander-water.timer, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now meander-water.timer
# Replace <DEPLOY_USER> with the Linux user that owns /var/www/meander-monitor.
#
# Type=oneshot: this runs, finishes, and exits. The TIMER owns the schedule —
# this unit must never be `enable`d itself, or it fires once at boot and never
# again. Enable meander-water.timer instead.

[Unit]
Description=meander-monitor water-level harvest (one run)
# The app serves the endpoint, so there is no point starting before it. Not a
# hard dependency: if the app is down, the run fails, the timer tries again in
# an hour, and the overlapping fetch window backfills whatever was missed.
After=network-online.target meander-monitor.service
Wants=network-online.target

[Service]
Type=oneshot
User=<DEPLOY_USER>

# CRON_SECRET lives here, next to the Munisense credentials the route reads.
EnvironmentFile=/var/www/meander-monitor/.env.local

# Straight to the app on localhost — nginx is on another box and this never
# needs to leave Patrick. --fail turns an HTTP error into a non-zero exit, so a
# failed harvest shows up as a failed unit in `systemctl status` instead of
# passing silently.
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 180 \
  -X POST http://127.0.0.1:3050/api/cron/water \
  -H "Authorization: Bearer ${CRON_SECRET}"
